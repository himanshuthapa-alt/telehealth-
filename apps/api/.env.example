# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Browser origins allowed in production (comma-separated); development allows localhost/LAN testing.
# WEB_ORIGINS=https://telecare.example.com,https://www.telecare.example.com
WEB_ORIGINS=
# Matches docker-compose.yml (dev-only credentials)
DATABASE_URL=postgres://telecare:telecare_dev_password@localhost:5432/telecare
# Used by the automated tests; they migrate and use this database
TEST_DATABASE_URL=postgres://telecare:telecare_dev_password@localhost:5432/telecare_test
# Signs access tokens (min 32 chars). Generate your own: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
# fake = demo video (no real call), none = chat-only consultations
VIDEO_PROVIDER=fake
LOG_LEVEL=info
# Optional: Groq API key for speech-to-text (Whisper) and symptom triage (gpt-oss-120b)
# GROQ_API_KEY=gsk_...
TRIAGE_MODEL=gpt-oss-120b
