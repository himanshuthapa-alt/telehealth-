# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Matches docker-compose.yml (dev-only credentials)
DATABASE_URL=postgres://telecare:telecare_dev_password@localhost:5432/telecare
# Used by the automated tests; they migrate and use this database
TEST_DATABASE_URL=postgres://telecare:telecare_dev_password@localhost:5432/telecare_test
# Signs access tokens (min 32 chars). Generate your own: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
# hms = real video via 100ms (fill HMS_* below), fake = demo video (no real call), none = chat-only
VIDEO_PROVIDER=fake
LOG_LEVEL=info
# Chatterbox TTS service (text-to-speech voice output)
TTS_BASE_URL=http://localhost:4123
# Sarvam AI (dashboard.sarvam.ai, ₹100 free credits): voice commands + replies in 23 Indian languages.
# Empty = on-device English recognition and Chatterbox voice.
SARVAM_API_KEY=
# Doctor directory: local (Postgres) or practo (external partner; stub, needs partner approval + API keys)
DOCTOR_PROVIDER=local
# Order fulfillment: local (in-house pharmacy queue) or partner (external delivery, e.g. 1mg; stub, needs partner approval + API keys)
FULFILLMENT_PROVIDER=local
# Real video: set VIDEO_PROVIDER=hms and fill these from the 100ms dashboard (Developer section).
# Role names must match your 100ms template's roles.
HMS_ACCESS_KEY=
HMS_APP_SECRET=
HMS_TEMPLATE_ID=
HMS_DOCTOR_ROLE=host
HMS_PATIENT_ROLE=guest
# Web origins allowed to call the API (Expo web build). Add your hosted web URL here.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082
