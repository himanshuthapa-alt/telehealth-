# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Matches docker-compose.yml (dev-only credentials)
DATABASE_URL=postgres://telecare:telecare_dev_password@localhost:5432/telecare
# Used by the automated tests; they migrate and use this database
TEST_DATABASE_URL=postgres://telecare:telecare_dev_password@localhost:5432/telecare_test
# Signs access tokens (min 32 chars). Generate your own: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
# fake = demo video (no real call), none = chat-only consultations
VIDEO_PROVIDER=fake
LOG_LEVEL=info

# --- Voice-first triage (project map §8.4) ---
# Every provider has a `fake` mode, so the whole stack runs with NO keys and NO cost.
# Set a provider to its real value + add the key to go live.
STT_PROVIDER=fake          # groq | sarvam | fake   (groq = Whisper, free tier)
LLM_PROVIDER=fake          # groq | fake            (groq = gpt-oss-120b, free tier)
TTS_PROVIDER=fake          # google | sarvam | device | fake
TELEPHONY_PROVIDER=fake    # exotel | fake | none
# Get a free key at https://console.groq.com  (then set STT_PROVIDER/LLM_PROVIDER=groq)
# GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-120b
# Google Cloud TTS (WaveNet, 4M free chars/month). Set TTS_PROVIDER=google to use.
# GCP_TTS_KEY=
# SARVAM_API_KEY=
# Hours to keep raw symptom audio server-side. 0 = never stored (DPDP default).
VOICE_AUDIO_RETENTION_HOURS=0
TRIAGE_PROMPT_VERSION=v1
