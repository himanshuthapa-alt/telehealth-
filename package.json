{
  "name": "telecare-plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TeleCare+: Remote Health & Pharmacy Platform (college minor project)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @telecare/api",
    "dev:api": "npm run dev -w @telecare/api",
    "dev:mobile": "npm run start -w @telecare/mobile",
    "lint": "eslint . && npm run lint -w @telecare/mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:seed": "npm run db:seed -w @telecare/api",
    "db:demo-reset": "npm run db:demo-reset -w @telecare/api --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0"
  },
  "overrides": {
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0"
  }
}
